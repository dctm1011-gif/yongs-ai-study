{
  "name": "yongstudyapp",
  "main": "index.js",
  "version": "1.0.0",
  "sideEffects": false,
  "dependencies": {
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@react-navigation/bottom-tabs": "^6.5.8",
    "@react-navigation/material-top-tabs": "^6.6.0",
    "@react-navigation/native": "^6.1.9",
    "@react-navigation/native-stack": "^6.9.17",
    "expo": "~54.0.36",
    "expo-av": "~16.0.8",
    "expo-background-fetch": "~14.0.9",
    "expo-build-properties": "~1.0.10",
    "expo-notifications": "~0.32.17",
    "expo-screen-orientation": "~9.0.9",
    "expo-speech": "~14.0.8",
    "expo-task-manager": "~14.0.9",
    "firebase": "^12.16.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-pager-view": "^6.9.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-tab-view": "^4.3.1",
    "react-native-web": "^0.21.0",
    "react-native-webview": "^13.15.0"
  },
  "devDependencies": {
    "@netlify/functions": "^5.3.0",
    "@types/node": "^26.1.1",
    "@types/react": "~19.1.10",
    "typescript": "~5.9.2"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "dev": "node scripts/dev.js",
    "build": "node scripts/build.js",
    "test:netlify": "node .github/scripts/test-netlify-functions.mjs",
    "monitor:netlify": "python3 .github/scripts/monitor-netlify.py",
    "check:functions": "node netlify/functions/test-all.mjs",
    "pre-commit-check": "node .github/scripts/pre-commit-check.js",
    "auto-fix": "node .github/scripts/auto-debug-and-fix.js",
    "ready-to-commit": "npm run auto-fix && npm run pre-commit-check",
    "build-and-debug": "powershell -ExecutionPolicy Bypass -File ./build-and-debug.ps1",
    "bundle-analyze": "node --max-old-space-size=4096 ./node_modules/.bin/metro --entry-file index.js --dev false --platform android --bundle-output android.js --report-filename sizeReport.json",
    "lighthouse": "npx lighthouse https://yongstudy.com --view --output-path ./lighthouse-report.html"
  },
  "private": true
}
